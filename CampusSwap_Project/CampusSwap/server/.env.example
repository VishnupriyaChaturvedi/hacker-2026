# Copy to .env and adjust. All values are optional for local development.
PORT=4000
HOST=127.0.0.1
# CHANGE THIS IN PRODUCTION. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Where the JSON datastore is written (relative paths resolve from the server folder).
DATA_FILE=./data/db.json
# Set to "production" when deployed behind HTTPS.
NODE_ENV=development
