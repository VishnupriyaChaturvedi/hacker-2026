# Copy to .env and adjust as needed.

# --- Database ---------------------------------------------------------------
# Localhost (default): a SQLite file next to this file.
DATABASE_URL=sqlite:///./campusswap.db
# Later, for PostgreSQL just change one line:
# DATABASE_URL=postgresql+psycopg2://campusswap:campusswap@localhost:5432/campusswap

# --- Security ---------------------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
